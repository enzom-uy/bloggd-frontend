---
import Layout from "../layouts/Layout.astro"
import { SignUpWrapper } from "@/components/sign-up/sign-up"
import { SignIn } from "@/components/sign-in/sign-in"
import { SearchInput } from "@/components/search-input"

export const prerender = false
---

<Layout>
  <div
    class="flex min-h-screen max-w-72 min-w-screen items-center justify-center"
  >
    <SignUpWrapper client:load />
    <div class="bg-slate-800">
      Sign In
      <SignIn client:load />
    </div>
  </div>
</Layout>
