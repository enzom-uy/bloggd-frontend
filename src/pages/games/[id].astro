---
export const prerender = false

import Layout from "@/layouts/Layout.astro"
import { GameStats } from "@/components/game-view/game-stats"
import { GameStatsSkeleton } from "@/components/game-view/game-stats-skeleton"
import { GameContent } from "@/components/game-view/game-content"
import { GamePlatforms } from "@/components/game-view/game-platforms"

import { auth } from "@/lib/auth-server"
import { fetchGameById } from "@/api/games"
import { GameTitleCard } from "@/components/game-view/game-title-card"

const session = await auth.api.getSession({
  headers: Astro.request.headers,
})

const { id: gameId } = Astro.params as { id: string }
if (!gameId) Astro.redirect("/")

const response = await fetchGameById({
  id: gameId as string,
  sessionToken: session ? session.session.id : "",
})

if (!response || response === undefined) return Astro.redirect("/not-found")

const {
  title,
  coverUrl,
  createdAt,
  description,
  developer,
  publisher,
  releaseDate,
  slug,
} = response.game
---

<Layout title={title}>
  <div class="flex flex-col gap-8 sm:flex-row">
    <div class="flex flex-col gap-4">
      <GameTitleCard userSession={session?.user} game={response.game} />
      <GameStats
        server:defer
        igdbId={gameId}
        sessionToken={session?.session.id}
      >
        <GameStatsSkeleton slot="fallback" />
      </GameStats>
    </div>
    <GameContent game={response.game} client:load />
    <GamePlatforms server:defer />
  </div>
</Layout>
